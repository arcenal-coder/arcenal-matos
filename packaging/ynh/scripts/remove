#!/bin/bash
source _common.sh
source /usr/share/yunohost/helpers

if systemctl cat "$app-jobs.timer" >/dev/null 2>&1; then
    ynh_systemctl --service="$app-jobs.timer" --action=stop
fi
if systemctl cat "$app-jobs.service" >/dev/null 2>&1; then
    ynh_systemctl --service="$app-jobs" --action=stop
fi
ynh_config_remove_systemd "$app-jobs"
ynh_safe_rm "/etc/systemd/system/$app-jobs.timer"
if ynh_hide_warnings yunohost service status "$app" >/dev/null; then
    yunohost service remove "$app"
fi
ynh_config_remove_systemd
ynh_config_remove_nginx
systemctl daemon-reload
