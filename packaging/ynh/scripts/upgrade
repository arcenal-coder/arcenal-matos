#!/bin/bash
source _common.sh
source /usr/share/yunohost/helpers

ynh_script_progression "Arrêt pour mise à jour..."
ynh_systemctl --service="$app-jobs.timer" --action=stop
ynh_systemctl --service="$app-jobs" --action=stop
ynh_systemctl --service="$app" --action=stop
ynh_setup_source --dest_dir="$install_dir" --full_replace --keep=".env .venv"
chown -R "$app:www-data" "$install_dir"
matos_dependencies
matos_config
yunohost service add "$app" --description="ARCenal Matos" --log="/var/log/$app/$app.log"
matos_manage migrate --noinput
matos_manage refresh_branding || ynh_print_info "Logo mis en cache conservé ; personnalisation YunoHost réessayée par le timer."
matos_manage collectstatic --noinput
ynh_systemctl --service="$app" --action=start
systemctl enable --now "$app-jobs.timer"
ynh_script_progression "Mise à jour ARCenal Matos terminée"
