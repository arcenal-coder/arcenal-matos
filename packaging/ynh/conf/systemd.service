[Unit]
Description=ARCenal Matos
After=network.target postgresql.service

[Service]
User=__APP__
Group=www-data
RuntimeDirectory=__APP__
RuntimeDirectoryMode=0750
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/.env
ExecStart=__INSTALL_DIR__/.venv/bin/uvicorn matos.asgi:application --uds /run/__APP__/web.sock --proxy-headers --forwarded-allow-ips "*"
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0007

[Install]
WantedBy=multi-user.target
